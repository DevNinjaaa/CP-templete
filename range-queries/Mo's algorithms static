// https://cses.fi/problemset/task/1646
#include <bits/stdc++.h>
using namespace std;
typedef unsigned long long ll;

class Mo_sAlgorithms
{
public:
    ll n;
    int len;
    vector<ll> data;
    vector<ll> store;

    Mo_sAlgorithms(ll n, vector<ll> data)
    {
        this->n = n;
        this->len = int(sqrt(n)) + 1;
        this->data.assign(data.begin(), data.end());
        this->store = vector<ll>(len, 0);

        for (int i = 0; i < n; i++)
            store[i / len] += data[i];
    }
    ll sumQuery(int l, int r)
    {
        if (r < l)
            return -1;

        ll sum = 0;
        while (l <= r)
        {
            if (l % len == 0 && l + len - 1 <= r)
            {
                sum += store[l / len];
                l += len;
            }
            else
            {
                sum += data[l];
                l++;
            }
        }
        return sum;
    }
};
int main()
{
    ll n, m;
    cin >> n >> m;
    vector<ll> data(n);
    for (int i = 0; i < n; i++)
        cin >> data[i];
    Mo_sAlgorithms answer(n, data);
    for (int i = 0; i < m; i++)
    {
        ll l, r;
        cin >> l >> r;
        // if 1 indexed -1 if not let as it is
        cout << answer.sumQuery(l - 1, r - 1) << "\n";
    }

    return 0;
}
