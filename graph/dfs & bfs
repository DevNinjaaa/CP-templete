#include <bits/stdc++.h>
using namespace std;

void dfs(int s, unordered_map<int, vector<int>> &adj, unordered_map<int, bool> &visited, vector<int> &res)
{
    visited[s] = true;
    res.push_back(s);

    for (int u : adj[s])
    {
        if (!visited[u])
        {
            dfs(u, adj, visited, res);
        }
    }
}

vector<int> DFS(unordered_map<int, vector<int>> &adj, int start)
{
    unordered_map<int, bool> visited;
    vector<int> res;
    dfs(start, adj, visited, res);
    return res;
}

vector<int> BFS(unordered_map<int, vector<int>> &adj, int start)
{
    unordered_map<int, bool> visited;
    queue<int> q;
    vector<int> res;

    visited[start] = true;
    q.push(start);

    while (!q.empty())
    {
        int curr = q.front();
        q.pop();
        res.push_back(curr);

        for (int u : adj[curr])
        {
            if (!visited[u])
            {
                visited[u] = true;
                q.push(u);
            }
        }
    }

    return res;
}

int main()
{
    unordered_map<int, vector<int>> adj = {
        {0, {1, 2, 3}},
        {1, {0, 4}},
        {2, {0}},
        {3, {0}},
        {4, {1}}};

    int start = 0; // starting node for traversal

    vector<int> dfs_result = DFS(adj, start);
    cout << "DFS traversal: ";
    for (int v : dfs_result)
    {
        cout << v << " ";
    }
    cout << "\n";

    vector<int> bfs_result = BFS(adj, start);
    cout << "BFS traversal: ";
    for (int v : bfs_result)
    {
        cout << v << " ";
    }
    cout << "\n";

    return 0;
}
