// dfs and bfs code
#include <bits/stdc++.h>
using namespace std;
#define ll long long

void dfs(vector<vector<int>> &adj, vector<bool> &visited, int s, vector<int> &res)
{

    visited[s] = true;
    cout << s << "\n";

    res.push_back(s);

    for (int i : adj[s])
        if (visited[i] == false)
            dfs(adj, visited, i, res);
}

vector<int> DFS(vector<vector<int>> &adj)
{
    vector<bool> visited(adj.size(), false);
    vector<int> res;
    dfs(adj, visited, 0, res);
    return res;
}

vector<int> bfs(vector<vector<int>> &adj)
{
    int V = adj.size();
    vector<bool> visited(V, false);
    queue<int> q;
    vector<int> res;
    // starting node
    int s = 0;

    visited[s] = true;
    q.push(s);

    while (!q.empty())
    {

        int curr = q.front();
        q.pop();
        cout << curr << "\n";
        res.push_back(curr);

        for (int x : adj[curr])
        {
            if (!visited[x])
            {
                visited[x] = true;
                q.push(x);
            }
        }
    }

    return res;
}

int main()
{
    // input
    vector<vector<int>> adj = {
        {1, 4},
        {0, 2, 3},
        {1},
        {1},
        {0}};

    // test
    DFS(adj);
    // to be 0 1 2 3 4
    bfs(adj);
    // to be 0 1 4 2 3
    return 0;
}
