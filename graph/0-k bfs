#include <bits/stdc++.h>
using namespace std;

const int INF = numeric_limits<int>::max();

int main() {
    int n, m, k;
    cin >> n >> m >> k;

    unordered_map<int, vector<pair<int, int>>> adj;
    for (int i = 0; i < m; i++) {
        int u, v, w;
        cin >> u >> v >> w;
        adj[u].push_back({v, w});
    }

    int start;
    cin >> start;

    vector<int> d(n, INF);
    vector<bool> used(n, false);
    vector<queue<int>> bfs(k + 1);

    bfs[0].push(start);
    d[start] = 0;

    int pos = 0, num = 1;

    while (num > 0) {
        while (bfs[pos % (k + 1)].empty()) {
            ++pos;
        }

        int u = bfs[pos % (k + 1)].front();
        bfs[pos % (k + 1)].pop();
        --num;

        if (used[u]) continue;
        used[u] = true;

        for (auto [v, w] : adj[u]) {
            if (d[u] + w < d[v]) {
                d[v] = d[u] + w;
                bfs[d[v] % (k + 1)].push(v);
                ++num;
            }
        }
    }

    for (int i = 0; i < n; ++i) {
        if (d[i] == INF) cout << "INF ";
        else cout << d[i] << " ";
    }
    cout << endl;

    return 0;
}
